{
    "builds": [
        {
            "src": "multimedia/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "50mb",
                "runtime": "python3.12"
            }
        }
    ],
    "crons": [
        {"path": "/media-library/cloud/cleanup/", "schedule": "0 3 * * *"}
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "multimedia/wsgi.py"
        }
    ]
}
