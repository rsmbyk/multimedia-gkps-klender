# Copy to .env and fill in values.
# Do not commit .env (it is gitignored).

# --- Remote DB (e.g. Neon production) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# --- Or use local Postgres:
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up
# DATABASE_URL is overridden automatically for the local stack.

DJANGO_DEVELOPMENT_MODE=False
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,web
# Add your LAN IP for phone/tablet access on the same Wi-Fi, e.g. 192.168.100.237

# --- Vercel production (set in Project → Settings → Environment Variables) ---
# DATABASE_URL=postgresql://...
# DJANGO_SECRET_KEY=long-random-string
# DJANGO_DEBUG=False
# DJANGO_DEVELOPMENT_MODE=False
# Optional custom domain (Vercel *.vercel.app hosts are added automatically):
# DJANGO_ALLOWED_HOSTS=your-domain.example
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example

# Optional container startup flags
# RUN_MIGRATIONS=true
# COLLECT_STATIC=true
