# Local Docker Compose only. Copy to .env and fill in the production origin.
# Do not commit .env (it is gitignored).
#
# Start the stack with:
#   docker compose up --build
#
# .env is required for the media companion's production-origin allowlist.
# Other values below have safe Compose defaults and can be omitted if unchanged.
#
# Compose injects DATABASE_URL for the local Postgres service. Do not put a
# production database URL here — it will be overridden in compose, and local
# development must not depend on the remote database.
#
# Django's production secrets and settings live in Vercel. The local companion's
# production-origin allowlist below is Compose configuration for this computer.

# Published host ports. High numbers (IANA dynamic range) so the stack is
# unlikely to collide with other local apps. Internal container ports are
# unaffected: web still listens on 8000, Postgres on 5432.
# If either port is already taken, change it here — no need to edit
# docker-compose.yml. Restart the stack after changing.
WEB_PORT=63404
DB_PORT=59075

# Required by the local Media Library companion. Use the exact production
# scheme and hostname shown in the browser address bar; include a nonstandard
# port only if the site uses one. Omit paths and trailing slashes.
GKPS_MEDIA_PRODUCTION_ORIGIN=

# Optional for local R2 sharing tests. Use bucket-scoped S3 API credentials.
# Keep these on the Django web service only; the media companion receives
# per-file signed URLs and never needs the key or secret.
# GKPS_R2_ACCOUNT_ID=
# GKPS_R2_BUCKET=
# GKPS_R2_ACCESS_KEY_ID=
# GKPS_R2_SECRET_ACCESS_KEY=

DJANGO_SECRET_KEY=dev-insecure-local-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,web
# Add your LAN IP for phone/tablet access on the same Wi-Fi, e.g. 192.168.100.237

# Optional container startup flags (compose sets RUN_MIGRATIONS=true for web)
# RUN_MIGRATIONS=true
# COLLECT_STATIC=true
