# Copy to .env and fill in values.
# Do not commit .env (it is gitignored).

# --- Remote DB (e.g. Neon production) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# --- Or use local Postgres:
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up
# DATABASE_URL is overridden automatically for the local stack.

DJANGO_DEVELOPMENT_MODE=False
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,web
# Add your LAN IP for phone/tablet access on the same Wi-Fi, e.g. 192.168.100.237
# DJANGO_SECRET_KEY=change-me

# Optional container startup flags
# RUN_MIGRATIONS=true
# COLLECT_STATIC=true
