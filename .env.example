# Local Docker Compose only. Copy to .env and fill in values.
# Do not commit .env (it is gitignored).
#
# Start the stack with:
#   docker compose up --build
#
# .env is OPTIONAL: compose supplies safe defaults for everything the app needs
# to boot. Copy this file only if you want to change the defaults below.
#
# Compose injects DATABASE_URL for the local Postgres service. Do not put a
# production database URL here — it will be overridden in compose, and local
# development must not depend on the remote database.
#
# Production env vars are set in Vercel (see docs/ARCHITECTURE.md), not here.

# Published host ports. High numbers (IANA dynamic range) so the stack is
# unlikely to collide with other local apps. Internal container ports are
# unaffected: web still listens on 8000, Postgres on 5432.
# If either port is already taken, change it here — no need to edit
# docker-compose.yml. Restart the stack after changing.
WEB_PORT=63404
DB_PORT=59075

DJANGO_SECRET_KEY=dev-insecure-local-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,web
# Add your LAN IP for phone/tablet access on the same Wi-Fi, e.g. 192.168.100.237

# Optional container startup flags (compose sets RUN_MIGRATIONS=true for web)
# RUN_MIGRATIONS=true
# COLLECT_STATIC=true
